rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Match document rules for games
    match /games/{gameId} {
      allow read: if true;
      allow create, update: if isValidId(gameId);
      allow delete: if isValidId(gameId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
